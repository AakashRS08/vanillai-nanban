# Copy to .env and fill in. Never commit .env.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-db
# At least 32 characters. Generate one with:  openssl rand -base64 48
NANBAN_JWT_SECRET=
# Comma-separated emails that get the Admin analytics panel
NANBAN_ADMIN_EMAILS=
# Optional: enables the LLM-powered chatbot. Without it, Nanban answers from weather data with simple rules.
ANTHROPIC_API_KEY=
